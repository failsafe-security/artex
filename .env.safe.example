# Copy this file to .env.safe and edit it. Never commit .env.safe.
#
# Use a unique, long password made of letters and digits. The compose file
# builds ARTEX_PG_DSN from POSTGRES_PASSWORD, so URL-special characters
# (@ : / ? # [ ]) would need escaping in both the password and the DSN.

POSTGRES_USER=artex
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=artex

# LLM provider. Loaded into the container by docker-compose.safe.yml.
# Prefer entering the key in the console after first boot; if you put it here,
# keep the file mode at 0600.
# Leave blank to infer the provider from whichever key is set.
ARTEX_LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
ARTEX_LLM_STREAM=1

# Optional: forbid norma from installing ripgrep with npm at runtime.
NORMA_RIPGREP_NO_INSTALL=1